# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright test artifacts
.playwright-mcp/

# 기밀 원본 데이터(가맹점 실매출 등) - 분석용으로만 로컬에 두고 git에는 올리지 않는다.
/reference/

# 1회성 라이브 검증 스크립트(관리자 자격증명으로 실서비스 Firestore를 읽는다) — 커밋 금지
live-check-out.txt
exp-out.txt
/.local-tools/

# Firestore 에뮬레이터 실행 로그 (npm run test:rules)
firestore-debug.log

# 세션 중 남는 실행 로그·임시 산출물. 작업 흔적이라 저장소에 넣지 않는다.
*.tmp.log
*.tmp.md
*.tmp.diff
v61-analysis-out.txt

# 로컬 보관 자료를 읽는 1회성 분석 테스트. 일반 실행에서 --exclude '**/_*.test.ts'로 빠지고
# CI·배포 대상이 아니다(관행: docs/releases의 여러 검토 문서 참고).
src/**/_*.test.ts

# 에이전트 도구의 기계별 설정
/.agents/
/.claude/
/.mcp.json
/skills-lock.json

# 검증용으로 받아본 내보내기 이미지(2026-09-11 FHD 확인). 결과는 docs/review-needed에 적었다.
/fhd-zoom-200.png

# Codex가 분석용으로 받아둔 외부 자료(PDF 등). 용량이 커서 저장소에 넣지 않는다.
/tmp/
