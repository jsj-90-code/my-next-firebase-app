rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 회사 구글 워크스페이스 계정(@isens.camp)으로 로그인한 팀원만 허용.
    // 클라이언트 쪽 도메인 검사를 우회해도 여기서 막히도록 서버(Firestore) 단에서 다시 확인한다.
    //
    // email_verified를 반드시 함께 본다(2026-09-10 보안감사에서 발견한 구멍을 막는 핵심 조건).
    // 이 프로젝트는 Firebase Auth의 이메일/비밀번호 가입이 켜져 있어서, 공개된
    // NEXT_PUBLIC_FIREBASE_API_KEY만 있으면 누구나 아무 비밀번호로 "무엇이든@isens.camp"
    // 계정을 스스로 만들 수 있다. 도메인 문자열만 검사하면 그 계정이 그대로 통과해 41개 가맹점
    // 매출 전체를 읽고 쓸 수 있었다. 메일함을 실제로 소유하지 않으면 email_verified가 참이 될 수
    // 없으므로 이 조건 하나로 그 경로가 막힌다(구글 워크스페이스 로그인은 항상 참이라 팀원은 영향 없음 —
    // 감사 시점 실사용 계정 4개 전부 google.com/인증완료).
    function isCompanyAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@isens[.]camp$');
    }

    // 좌석배치도 프로젝트: 회사 계정이면 누구나 읽고 쓸 수 있는 공유 문서
    // (기존 앱스크립트 버전이 스프레드시트 하나를 팀 전체가 공유하던 방식과 동일)
    match /seatLayoutProjects/{projectId} {
      allow read, write: if isCompanyAccount();
    }

    // 사양 드롭다운 옵션/기본값 설정 (모든 프로젝트가 공유하는 설정 문서 1개)
    match /seatLayoutSettings/{docId} {
      allow read, write: if isCompanyAccount();
    }

    // 점포평가(V61/V62) 시스템 -----------------------------------------------

    // 관리자 이메일 목록. 문서 자체는 Firebase 콘솔/관리자 SDK로만 등록하고,
    // 클라이언트에서는 절대 쓸 수 없게 해서 이 목록으로 스스로 권한을 올리는 것을 막는다.
    function isStoreEvalAdmin() {
      return isCompanyAccount()
        && exists(/databases/$(database)/documents/storeEvalAdmins/$(request.auth.token.email));
    }

    match /storeEvalAdmins/{email} {
      allow read: if isCompanyAccount();
      allow write: if false;
    }

    // 후보지코드(N001...) 자동 생성용 트랜잭션 카운터.
    match /storeEvalMeta/{docId} {
      allow read, write: if isCompanyAccount();
    }

    match /storeEvalCandidates/{candidateId} {
      allow read, write: if isCompanyAccount();
    }

    match /storeEvalCompetitors/{competitorId} {
      allow read, write: if isCompanyAccount();
    }

    // 상권자료 자동수집 1단계(2026-08-24) — 행정구역 참고자료(SGIS)와 수요거점(카카오)은
    // /api/store-eval/collect-market-data가 firebase-admin(보안규칙 우회)으로 쓰고, 클라이언트는
    // 읽기 전용 + 수요거점 확인표시만 한다.
    match /storeEvalAdminDongReferences/{candidateId} {
      allow read: if isCompanyAccount();
      allow write: if false;
    }

    match /storeEvalDemandPoints/{pointId} {
      allow read: if isCompanyAccount();
      allow create, delete: if false;
      // confirmed 필드만 클라이언트에서 갱신 가능하게 하려 했으나, Firestore 규칙에서
      // "변경된 필드만" 제한하려면 diff 검사가 필요해 일단 전체 update를 허용하고 UI에서만
      // confirmed 토글로 제한한다(내부 전용 도구이므로 위험도 낮음 - storeEvalCompetitors와 동일 수준).
      allow update: if isCompanyAccount();
    }

    // 상권자료 자동수집 2단계(2026-08-24) — SGIS/소상공인365 반자동 업로드 이력. 생성만 허용하고
    // 수정/삭제는 막아 "어느 파일에서 언제 뽑았는지" 기록이 사후에 바뀌지 않게 한다(storeEvalAuditLog와
    // 동일한 불변 로그 취급).
    match /storeEvalMarketDataUploads/{uploadId} {
      allow read, create: if isCompanyAccount();
      allow update, delete: if false;
    }

    match /storeEvalLocationEvaluations/{candidateId} {
      allow read, write: if isCompanyAccount();
    }

    // 평가 결과 스냅샷: 재계산 이력을 보존해야 하므로 삭제는 막고 생성/수정만 허용한다.
    match /storeEvalResults/{candidateId} {
      allow read, create, update: if isCompanyAccount();
      allow delete: if false;
    }

    // 모델 계수/판정기준: 일반 사용자는 읽기만, 변경은 관리자만.
    match /storeEvalSettings/{docId} {
      allow read: if isCompanyAccount();
      allow write: if isStoreEvalAdmin();
    }

    // 설정 변경 이력: 관리자만 생성, 아무도 수정/삭제하지 못한다.
    match /storeEvalSettingsHistory/{historyId} {
      allow read: if isCompanyAccount();
      allow create: if isStoreEvalAdmin();
      allow update, delete: if false;
    }

    // 기존 가맹점 마스터/월별매출 (구글시트 "가맹점전수조사" 동기화 대상)
    match /storeEvalExistingStores/{storeCode} {
      allow read, write: if isCompanyAccount();
    }

    // 매출DB 미러(구글시트 원본의 사본). CLAUDE.md의 "매출DB 절대 삭제 금지"를 규칙 단에서도
    // 강제한다 — 클라이언트 코드에 이 컬렉션을 지우는 경로가 애초에 없고(2026-09-10 확인),
    // 동기화(cronSync)는 firebase-admin이라 보안규칙을 우회하므로 삭제 차단의 부작용이 없다.
    match /storeEvalExistingStoreSales/{salesId} {
      allow read, create, update: if isCompanyAccount();
      allow delete: if false;
    }

    // 03_회원정보입력 스냅샷 - calc.ts 계산에는 안 쓰이는 참고 데이터지만
    // existing-stores 화면에서 클라이언트 SDK로 직접 읽고 쓴다.
    match /storeEvalExistingStoreMembers/{snapshotId} {
      allow read, write: if isCompanyAccount();
    }

    // 시스템 상태 문서.
    // - `cronSync`: 매일 크론이 firebase-admin으로 쓴다(규칙을 우회하므로 여기서 쓰기를 막아도 된다).
    // - `accuracy`: 검증화면이 계산한 모형 실측 정확도 요약. 후보지 결과 화면이 이 1건만 읽어
    //   "이 모형이 얼마나 맞는지"를 보여준다(후보지 화면에서 검증을 다시 돌리면 읽기가 800건쯤
    //   더 들기 때문에 요약을 거쳐 간다). 이 문서에만 클라이언트 쓰기를 허용한다.
    match /storeEvalSystemStatus/{docId} {
      allow read: if isCompanyAccount();
      allow write: if isCompanyAccount() && docId == "accuracy";
    }

    // 수정·삭제·재계산 이력: 생성만 허용(불변 로그), 수정/삭제 금지.
    match /storeEvalAuditLog/{logId} {
      allow read, create: if isCompanyAccount();
      allow update, delete: if false;
    }

    // 백업 복원 로그(요청사항 17) — storeEvalAuditLog와 동일하게 성공/실패 여부와 무관하게
    // 항상 기록되는 불변 로그. 실제 복원 쓰기(storeEvalCandidates 등)는 기존 컬렉션 규칙을
    // 그대로 따르고, 여기서는 로그 문서 자체만 다룬다.
    match /storeEvalRestoreLog/{logId} {
      allow read, create: if isCompanyAccount();
      allow update, delete: if false;
    }
  }
}
